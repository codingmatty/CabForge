# Copy to .env (git-ignored, blocked from the web) or set these as real
# environment variables (Apache SetEnv, php-fpm env, Docker). The AI chat
# appears in the app only when a key is set.

# One of these:
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional:
# CABFORGE_AI_PROVIDER=anthropic        # or openai (default: whichever key is set)
# CABFORGE_AI_MODEL=claude-opus-5-5     # default for Anthropic; e.g. claude-sonnet-5-5 costs half. Required for OpenAI.
# CABFORGE_AI_DAILY_LIMIT=200           # model calls per day, 0 = no limit
